# Local demo; copy to .env to override. Never commit .env.
APP_ENV=development
DEMO_MODE=true
PORT=8000
HARDWARE_MODE=simulated
# Blank in development generates a persistent key inside DATA_DIR.
APP_SECRET=
APP_ORIGIN=
DEVICE_TOKEN=
PAYMENT_WEBHOOK_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional Telegram notifications. Create a dedicated bot with @BotFather.
# Keep the token secret. Username is the bot username without @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Native Python only; Docker uses the named volume at /app/data.
DATA_DIR=./data
